# Same Neon Postgres instance used by the main clever-consumer backend (see repo root
# README). This service only ever reads/writes its own `demo_store` schema (see
# db/schema.sql), so it's safe to share the connection string.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Global fallback rotation cadence: a scenario track advances to its next layout variant
# every N loads. Overridable per-track below.
ROTATE_EVERY_N=4

# Per-track overrides (all optional, fall back to ROTATE_EVERY_N if unset)
ROTATE_EVERY_N_CATEGORY_STRUCTURE=
ROTATE_EVERY_N_CATEGORY_STYLE=
ROTATE_EVERY_N_SEARCH_STRUCTURE=
ROTATE_EVERY_N_SEARCH_LABEL=
ROTATE_EVERY_N_PRODUCT_LAYOUT=
ROTATE_EVERY_N_PRODUCT_JSONLD_SHAPE=
ROTATE_EVERY_N_PRODUCT_LABEL=

DEFAULT_CURRENCY=INR
STORE_BRAND_NAME=Stridex Market

# Optional shared secret gating /admin and /api/reset, since this site is publicly
# reachable. Leave blank to leave those routes open (fine for a hackathon demo).
ADMIN_TOKEN=
