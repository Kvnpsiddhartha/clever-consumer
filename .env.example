# App runtime
APP_ROLE=all
HTTP_ADDR=:18080
LOG_LEVEL=info
PUBLIC_BASE_URL=http://localhost:5173
SESSION_COOKIE_NAME=cc_session

# Database
# Use localhost when running the backend directly on your machine.
# Docker Compose overrides this to the postgres service hostname.
DATABASE_URL=postgres://clever:clever@localhost:55432/clever_consumer?sslmode=disable

# Bright Data
BRIGHTDATA_BIN=brightdata
BRIGHTDATA_API_BASE_URL=https://api.brightdata.com
BRIGHTDATA_API_KEY=
BRIGHTDATA_UNLOCKER_ZONE=cli_unlocker
BRIGHTDATA_TIMEOUT_SECONDS=1800
BRIGHTDATA_HEAL_RETRIES=1
BRIGHTDATA_DATASET_SEEDS=

# Collector pool
SCRAPER_COLLECTOR_REQUEST_THRESHOLD=500
SCRAPER_COLLECTOR_PRODUCT_THRESHOLD=100
SCRAPER_COLLECTOR_MAX_PER_DOMAIN=3

# Email
SMTP_FROM=alerts@clever-consumer.local
